{% extends "base.html.j2" %}
{% from "partials/page-icons.html.j2" import picon %}
{% set g = content.gut_health %}
{% block content %}
<section class="page-hero split">
  <div class="container split-inner">
    <div class="split-media" data-reveal><img src="{{ root }}assets/img/{{ g.hero_image }}" alt="" width="1100" height="629"></div>
    <div class="split-text" data-reveal>
      <h1 class="h2">{{ g.hero_title | e }}</h1>
      <p class="hero-subtitle">{{ g.hero_subtitle | e }}</p>
      <p class="lead">{{ g.hero_text | e }}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="{{ root }}shop/">{{ content.btn_shop_now | e }}</a>
        <a class="btn btn-outline" href="{{ root }}about/">{{ content.btn_explore_story | e }}</a>
      </div>
    </div>
  </div>
</section>

<section class="gut-benefits">
  <div class="container">
    <h2 class="h2 center" data-reveal>{{ g.benefits_title | e }}</h2>
    {#- The live site shows this intro on phones/tablets only. #}
    <p class="lead center gut-intro">{{ g.benefits_text | e }}</p>
    <ul class="gut-grid">
{%- for b in g.benefits %}
      <li class="gut-item" data-reveal>
        <span class="gut-icon">{{ picon(b.icon) }}</span>
        <h3 class="h3">{{ b.title | e }}</h3>
        <p class="gut-subtitle">{{ b.subtitle | e }}</p>
        <p class="gut-text">{{ b.text | e }}</p>
      </li>
{%- endfor %}
    </ul>
  </div>
</section>

<section class="why">
  <div class="container why-inner" data-reveal>
    <h2 class="h2">{{ g.why_title | e }}</h2>
    <p>{{ g.why_text | e }}</p>
    <div class="btn-row"><a class="btn btn-primary" href="{{ root }}about/">{{ content.btn_discover_story | e }}</a></div>
  </div>
</section>

{% include "partials/testimonials.html.j2" %}
{% endblock %}

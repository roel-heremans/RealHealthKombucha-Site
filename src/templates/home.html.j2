{% extends "base.html.j2" %}
{% from "partials/page-icons.html.j2" import picon %}
{% set h = content.home %}
{% block content %}
<section class="home-hero" style="background-image: url('{{ root }}assets/img/{{ h.hero_image }}')">
  <div class="home-hero-inner">
    <h1 class="h1">{{ h.hero_title | e }}</h1>
    <p class="home-hero-text">{{ h.hero_text | e }}</p>
    <div class="btn-row">
      <a class="btn btn-primary" href="{{ root }}shop/">{{ content.btn_shop_now | e }}</a>
      <a class="btn btn-outline" href="{{ root }}about/">{{ content.btn_explore_story | e }}</a>
    </div>
  </div>
</section>

<section class="benefits">
  <div class="container">
    <h2 class="h2 center" data-reveal>{{ h.benefits_title | e }}</h2>
    <ul class="benefit-grid">
{%- for b in h.benefits %}
      <li class="benefit-card" data-reveal>
        <span class="benefit-icon">{{ picon(b.icon) }}</span>
        <h3 class="benefit-title">{{ b.title | e }}</h3>
        <p>{{ b.text | e }}</p>
      </li>
{%- endfor %}
    </ul>
  </div>
</section>

{% include "partials/taste.html.j2" %}

<section class="flavours">
  <div class="flavours-head">
    <h2 class="h2">{{ h.flavours_title | e }}</h2>
    <p class="body-text">{{ h.flavours_text | e }}</p>
  </div>
  <div class="carousel" data-carousel>
    <ul class="carousel-track" tabindex="0" aria-label="{{ h.flavours_title | e }}">
{%- for f in h.flavours %}
      <li class="flavour-card">
        <img src="{{ root }}assets/img/{{ f.image }}" alt="" loading="lazy">
        <h3 class="flavour-name{% if f.light %} is-light{% endif %}">{{ f.name | e }}</h3>
      </li>
{%- endfor %}
    </ul>
    <div class="carousel-dots" aria-hidden="true">{% for f in h.flavours %}<span></span>{% endfor %}</div>
    <div class="carousel-arrows">
      <button type="button" class="carousel-prev" aria-label="Previous flavour"><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M22.5 12.5 15 20l7.5 7.5"/></svg></button>
      <button type="button" class="carousel-next" aria-label="Next flavour"><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M17.5 12.5 25 20l-7.5 7.5"/></svg></button>
    </div>
  </div>
</section>

<section class="magic">
  <div class="container">
    <h2 class="h2 magic-title" data-reveal>{{ h.magic_title | e }}</h2>
    <ul class="magic-grid">
{%- for m in h.magic %}
      <li class="magic-card" style="--phone-order: {{ m.phone_order }}" data-reveal>
        <img src="{{ root }}assets/img/{{ m.image }}" alt="" loading="lazy"{% if m.focus %} style="object-position: {{ m.focus }}"{% endif %}>
        <h3 class="h3">{{ m.title | e }}</h3>
        <p class="lead">{{ m.text | e }}</p>
      </li>
{%- endfor %}
    </ul>
  </div>
</section>

{% include "partials/testimonials.html.j2" %}

<section class="faq">
  <div class="container faq-inner">
    <h2 class="h2 center" data-reveal>{{ h.faq_title | e }}</h2>
    <div class="faq-list">
{%- for item in h.faq %}
      <details class="faq-item"{% if loop.first %} open{% endif %}>
        <summary>{{ item.q | e }}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9l7 7 7-7"/></svg></summary>
        <p>{{ item.a | e }}</p>
      </details>
{%- endfor %}
    </div>
  </div>
</section>
{% endblock %}

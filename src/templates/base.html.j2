<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% if content.preview %}<meta name="robots" content="noindex">
{% endif %}<title>{{ page.title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alegreya:wght@400&family=DM+Sans:wght@400;500;700&family=Figtree:wght@400;600&family=Inter:wght@400;500;600;700&family=Lato:ital,wght@0,300;0,400;0,700;1,400&family=Playfair+Display:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="{{ root }}assets/css/styles.css">
<script>document.documentElement.classList.add("js");</script>
</head>
<body class="page-{{ page.slug or 'home' }}">
{% include "partials/banner.html.j2" %}
{% include "partials/header.html.j2" %}
<main>
{% block content %}{% endblock %}
</main>
{% include "partials/footer.html.j2" %}
<script src="{{ root }}assets/js/site.js" defer></script>
</body>
</html>

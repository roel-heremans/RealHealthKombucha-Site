<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% if content.preview %}<meta name="robots" content="noindex">
{% endif %}{% set page_title = page.title | t %}<title>{% if page.id == "home" %}{{ page_title | e }}{% else %}{{ page_title | e }} - {{ content.site_name | e }}{% endif %}</title>
<link rel="icon" type="image/png" href="{{ root }}assets/img/favicon.png">
{%- for l in LANGS %}
<link rel="alternate" hreflang="{{ l }}" href="{{ content.site_url }}{{ page_path(page, l) }}">
{%- endfor %}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ content.site_name | e }}">
<meta property="og:title" content="{{ page_title | e }}">
<meta property="og:url" content="{{ content.site_url }}{{ path }}">
<link rel="stylesheet" href="{{ root }}assets/css/styles.css">
<script>document.documentElement.classList.add("js");</script>
</head>
<body class="page-{{ page.id }}">
{% include "partials/header.html.j2" %}
<main>
{% block content %}
<section class="page-skeleton">
  <h1>{{ page.title | t | e }}</h1>
</section>
{% endblock %}
</main>
{% include "partials/footer.html.j2" %}
<script src="{{ root }}assets/js/site.js" defer></script>
</body>
</html>

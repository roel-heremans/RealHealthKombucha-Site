{% from "partials/icons.html.j2" import icon %}
<footer class="site-footer">
  <div class="footer-inner">
    <ul class="footer-socials">
      <li><a href="{{ content.links.instagram | e }}" target="_blank" rel="noopener" aria-label="Instagram">{{ icon("instagram") }}</a></li>
      <li><a href="{{ content.links.whatsapp | e }}" target="_blank" rel="noopener" aria-label="WhatsApp">{{ icon("whatsapp") }}</a></li>
    </ul>
    <nav class="footer-nav" aria-label="Footer">
      <ul>
{%- for p in content.pages %}
        <li><a href="{{ url(p.id) }}"{% if p.id == page.id %} aria-current="page"{% endif %}>{{ p.nav | t | e }}</a></li>
{%- endfor %}
      </ul>
    </nav>
    <p class="footer-contact"><a href="mailto:{{ content.links.email | e }}">{{ content.links.email | e }}</a> · <a href="tel:{{ content.links.phone | replace(' ', '') | e }}">{{ content.links.phone | e }}</a></p>
  </div>
  <div class="footer-bottom">
    <p>© {{ year }} {{ content.site_name | e }}. {{ content.ui.rights | t | e }}</p>
  </div>
</footer>

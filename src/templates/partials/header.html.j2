<header class="site-header">
  <div class="header-inner">
    <a class="logo" href="{{ url('home') }}" aria-label="{{ content.site_name | e }}"><img src="{{ root }}assets/img/logo.png" alt="{{ content.site_name | e }}" width="315" height="223"></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="{{ content.ui.menu | t | e }}"><span></span><span></span><span></span></button>
    <nav class="site-nav" id="site-nav" aria-label="{{ content.ui.menu | t | e }}">
      <ul>
{%- for p in content.pages %}
        <li><a href="{{ url(p.id) }}"{% if p.id == page.id %} aria-current="page"{% endif %}>{{ p.nav | t | e }}</a></li>
{%- endfor %}
      </ul>
    </nav>
    <p class="lang-switcher">{% if lang == "en" %}<span class="lang-current">EN</span> | <a class="lang-switch" href="{{ switch_url }}" hreflang="pt" lang="pt" title="{{ content.ui.switch_title | t | e }}">PT</a>{% else %}<a class="lang-switch" href="{{ switch_url }}" hreflang="en" lang="en" title="{{ content.ui.switch_title | t | e }}">EN</a> | <span class="lang-current">PT</span>{% endif %}</p>
  </div>
</header>

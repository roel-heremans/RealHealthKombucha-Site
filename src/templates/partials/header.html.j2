{%- set pages_by_id = {} -%}
{%- for p in content.pages %}{% set _ = pages_by_id.update({p.id: p}) %}{% endfor -%}
<header class="site-header">
  <div class="header-inner container">
    <a class="logo" href="{{ url('home') }}"><img src="{{ root }}assets/img/logo-light.png" alt="{{ content.site_name | e }}" width="1468" height="956"></a>
    <div class="nav-panel" id="site-nav">
      <nav class="site-nav" aria-label="{{ content.ui.menu | t | e }}">
        <ul>
{%- for nid in content.nav_ids %}{% set p = pages_by_id[nid] %}
          <li{% if nid == "home" %} class="nav-home"{% endif %}><a href="{{ url(nid) }}"{% if nid == page.id %} aria-current="page"{% endif %}>{{ p.nav | t | e }}</a></li>
{%- endfor %}
        </ul>
      </nav>
      <a class="header-order btn btn--outline-light" href="{{ url('order') }}"{% if page.id == "order" %} aria-current="page"{% endif %}>{{ content.order_button | t | e }}</a>
    </div>
    {% include "partials/lang-switch.html.j2" %}
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="{{ content.ui.menu_open | t | e }}" data-label-open="{{ content.ui.menu_open | t | e }}" data-label-close="{{ content.ui.menu_close | t | e }}"><span></span><span></span><span></span></button>
  </div>
</header>

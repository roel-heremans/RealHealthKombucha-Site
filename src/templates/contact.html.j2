{% extends "base.html.j2" %}
{% from "partials/icons.html.j2" import icon %}
{% block content %}
{%- set c = content.contact_page -%}
{%- set w = c.ways -%}
{%- set links = content.links -%}

<section class="hero hero--short contact-hero">
  <div class="hero__text">
    <p class="eyebrow">{{ c.hero.eyebrow | t | e }}</p>
    <h1 class="display display--hero">{{ c.hero.heading | t | e }} <em>{{ c.hero.heading_accent | t | e }}</em></h1>
    <p class="lead">{{ c.hero.lead | t | e }}</p>
  </div>
  <div class="hero__media">
    <img src="{{ root }}{{ c.hero.image }}" alt="{{ c.hero.alt | t | e }}" width="1000" height="1333" fetchpriority="high">
  </div>
</section>

<section class="section section--white contact-ways">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{{ w.eyebrow | t | e }}</p>
      <h2 class="h-section">{{ w.heading | t | e }} <em>{{ w.heading_accent | t | e }}</em></h2>
    </div>
    <ul class="grid grid--3 contact-grid">
      <li class="contact-item" data-reveal>
        <span class="contact-item__icon">{{ icon("whatsapp") }}</span>
        <h3 class="h-card">{{ w.whatsapp.title | t | e }}</h3>
        <p class="body">{{ w.whatsapp.text | t | e }}</p>
        <div class="btn-row"><a class="btn btn--gold" href="{{ links.whatsapp | e }}" target="_blank" rel="noopener">{{ w.whatsapp.button | t | e }}</a></div>
      </li>
      <li class="contact-item" data-reveal>
        <span class="contact-item__icon">{{ icon("instagram") }}</span>
        <h3 class="h-card">{{ w.instagram.title | t | e }}</h3>
        <p class="body">{{ w.instagram.text | t | e }}</p>
        <div class="btn-row"><a class="btn btn--forest" href="{{ links.instagram | e }}" target="_blank" rel="noopener">{{ w.instagram.button | t | e }}</a></div>
      </li>
      <li class="contact-item" data-reveal>
        <span class="contact-item__icon">{{ icon("mail") }}</span>
        <h3 class="h-card">{{ w.email.title | t | e }}</h3>
        <p class="body">{{ w.email.text | t | e }}</p>
        <p class="contact-item__value"><a href="mailto:{{ links.email | e }}">{{ links.email | e }}</a></p>
        <div class="btn-row"><a class="btn btn--outline-dark" href="mailto:{{ links.email | e }}">{{ w.email.button | t | e }}</a></div>
      </li>
    </ul>
    <div class="grid grid--2 contact-details">
      <div class="contact-detail">
        <p class="eyebrow">{{ w.phone | t | e }}</p>
        <p class="contact-detail__value"><a href="tel:{{ links.phone | replace(' ', '') | e }}">{{ links.phone | e }}</a></p>
      </div>
      <div class="contact-detail">
        <p class="eyebrow">{{ w.address | t | e }}</p>
        <address class="contact-detail__address">
{%- for part in content.address.split(", ") -%}
<span>{{ part | e }}{% if not loop.last %},{% endif %}</span>{% if not loop.last %} {% endif %}
{%- endfor -%}
</address>
        <p class="contact-detail__link"><a class="text-link" href="{{ links.maps | e }}" target="_blank" rel="noopener">{{ w.maps | t | e }} &rarr;</a></p>
      </div>
    </div>
  </div>
</section>
{% endblock %}

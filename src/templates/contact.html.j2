{% extends "base.html.j2" %}
{% block content %}
<section class="contact-hero">
  <div class="container center">
    <h1 class="h1 contact-title">{{ content.contact_title | e }}</h1>
    <p class="lead contact-sub">{{ content.contact_subtitle | e }}</p>
  </div>
</section>

<section class="contact-form-wrap">
  <form class="contact-form"{% if content.preview %} data-preview="true"{% else %} action="{{ content.contact_form_endpoint | e }}" method="post"{% endif %}>
    <label class="field"><span class="field-label">Name</span><input type="text" name="name" autocomplete="name" required></label>
    <label class="field"><span class="field-label">Email</span><input type="email" name="email" autocomplete="email" required></label>
    <label class="field"><span class="field-label">Message</span><textarea name="message" rows="4" required></textarea></label>
    <div class="hp-field" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
    <button class="contact-submit" type="submit">Submit</button>
    <p class="form-status" role="status" aria-live="polite" data-notice="{{ content.preview_notice | e }}"></p>
  </form>
</section>

<section class="contact-info">
  <div class="container contact-info-grid">
    <div><h2 class="contact-h">Call Us:</h2><a class="contact-phone" href="tel:{{ content.contact_phone | replace(' ', '') | e }}">{{ content.contact_phone | e }}</a></div>
    <div><h2 class="contact-h">Hours:</h2><p class="lead">{{ content.contact_hours | e }}</p></div>
    <div><h2 class="contact-h">Our Location:</h2><p class="lead">{{ content.contact_address | e }}</p></div>
  </div>
</section>
{% endblock %}

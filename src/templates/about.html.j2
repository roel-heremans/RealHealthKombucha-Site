{% extends "base.html.j2" %}
{% set a = content.about %}
{% block content %}
<section class="page-hero split">
  <div class="container split-inner">
    <div class="split-media" data-reveal><img src="{{ root }}assets/img/{{ a.hero_image }}" alt="" width="677" height="902" style="object-position: {{ a.hero_image_focus }}"></div>
    <div class="split-text" data-reveal>
      <h1 class="h2">{{ a.hero_title | e }}</h1>
      <p class="lead">{{ a.hero_text | e }}</p>
    </div>
  </div>
</section>

<section class="mission">
  <div class="container mission-inner">
    <div class="mission-text">
      <h2 class="h2" data-reveal>{{ a.mission_title | e }}</h2>
      <p class="lead" data-reveal>{{ a.mission_text | e }}</p>
      <ul class="stats">
{%- for s in a.stats %}
        <li class="stat" data-reveal><span class="stat-number">{{ s.number | e }}</span> <span class="stat-label">{{ s.label | e }}</span></li>
{%- endfor %}
      </ul>
    </div>
    <div class="mission-media" data-reveal><img src="{{ root }}assets/img/{{ a.mission_image }}" alt="" loading="lazy"></div>
  </div>
</section>

<section class="split story">
  <div class="container split-inner">
    <div class="split-media" data-reveal><img src="{{ root }}assets/img/{{ a.story_image }}" alt="" loading="lazy"></div>
    <div class="split-text" data-reveal>
      <h2 class="h2">{{ a.story_title | e }}</h2>
{%- for para in a.story_paragraphs %}
      <p class="lead">{{ para | e }}</p>
{%- endfor %}
      <div class="btn-row"><a class="btn btn-primary" href="{{ root }}shop/">{{ a.story_button | e }}</a></div>
    </div>
  </div>
</section>

<section class="values">
  <div class="container">
    <h2 class="h2" data-reveal>{{ a["values_title"] | e }}</h2>
    <p class="lead values-text" data-reveal>{{ a["values_text"] | e }}</p>
    <ul class="values-grid">
{%- for v in a["values"] %}
      <li class="value-card" data-reveal>
        <img src="{{ root }}assets/img/{{ v.image }}" alt="" loading="lazy"{% if v.focus %} style="object-position: {{ v.focus }}"{% endif %}>
        <h3 class="h3">{{ v.title | e }}</h3>
        <p class="lead">{{ v.text | e }}</p>
      </li>
{%- endfor %}
    </ul>
  </div>
</section>

<section class="place">
  <div class="place-card" style="background-image: url('{{ root }}assets/img/{{ a.place_image }}')" data-reveal>
    <h2 class="h2">{{ a.place_title | e }}</h2>
    <p>{{ a.place_text | e }}</p>
  </div>
</section>

{% include "partials/testimonials.html.j2" %}
{% endblock %}

{% extends "base.html.j2" %}
{% import "partials/about-sections.html.j2" as sections %}
{% set a = content.about %}
{% block content %}
<section class="page-hero split">
  <div class="container split-inner">
    <div class="split-media" data-reveal><img src="{{ root }}assets/img/{{ a.hero_image }}" alt="" width="677" height="902" style="object-position: {{ a.hero_image_focus }}"></div>
    <div class="split-text" data-reveal>
      <h1 class="h2">{{ a.hero_title | e }}</h1>
      <p class="lead">{{ a.hero_text | e }}</p>
    </div>
  </div>
</section>

{{ sections.mission(a, root) }}

<section class="split story">
  <div class="container split-inner">
    <div class="split-media" data-reveal><img src="{{ root }}assets/img/{{ a.story_image }}" alt="" loading="lazy"></div>
    <div class="split-text" data-reveal>
      <h2 class="h2">{{ a.story_title | e }}</h2>
{%- for para in a.story_paragraphs %}
      <p class="lead">{{ para | e }}</p>
{%- endfor %}
      <div class="btn-row"><a class="btn btn-primary" href="{{ root }}shop/">{{ a.story_button | e }}</a></div>
    </div>
  </div>
</section>

{{ sections.values(a, root) }}

{{ sections.place(a, root) }}

{% include "partials/testimonials.html.j2" %}
{% endblock %}
